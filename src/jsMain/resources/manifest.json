{
    "manifest_version": 3,
    "name": "GoofyAhhSounds",
    "version": "0.1",
    "description": "A web extension to upload and play sound",
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "storage",
        "unlimitedStorage"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "goofyahhsounds@hero"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}